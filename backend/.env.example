# Copy to .env and adjust for your environment.
# Port the API server listens on (default 3001).
PORT=3001

# SQLite file used by the API, migrations and the demo seed.
# Leave unset to default to ./data/app.db inside the backend directory.
DATABASE_URL=

# Secret used to sign session cookies (set to a long random value in production).
SESSION_SECRET=vidyasetu-sih-demo-secret
