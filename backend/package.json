{
  "name": "pragyan-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pragyan — REST API server (Express + SQLite/Drizzle). Smart India Hackathon 2026.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "0.45.2",
    "express": "^4.21.2",
    "multer": "^2.3.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.15",
    "@types/sql.js": "^1.4.11",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
